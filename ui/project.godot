; Engine configuration file.
; Godot 4.4+ project for the Meeting Transcriptions UI.

config_version=5

[application]

config/name="Meeting Transcriptions"
config/description="Live meeting transcription with speakers in a circle."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/subwindows/embed_subwindows=false

[gui]

theme/default_font_antialiasing=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.067, 0.075, 0.102, 1)
textures/vram_compression/import_etc2_astc=true
